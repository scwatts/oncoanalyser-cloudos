params {

    max_fastq_records = 250000000

    genomes {
        'GRCh38_umccr' {
            fasta         = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/GRCh38_full_analysis_set_plus_decoy_hla.fa"
            fai           = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/samtools_index/1.16/GRCh38_full_analysis_set_plus_decoy_hla.fa.fai"
            dict          = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/samtools_index/1.16/GRCh38_full_analysis_set_plus_decoy_hla.fa.dict"
            img           = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/bwa_index_image/0.7.17-r1188/GRCh38_full_analysis_set_plus_decoy_hla.fa.img"
            gridss_index  = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/gridss_index/2.13.2/"
            bwamem2_index = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/bwa-mem2_index/2.2.1/"
            star_index    = "s3://oncoanalyser-data/reference_data/genomes/GRCh38_umccr/star_index/gencode_38/2.7.3a/"
        }
    }

    ref_data_hmf_data_path = "s3://oncoanalyser-data/reference_data/hmf_reference_data/hmftools/hmf_pipeline_resources.38_v2.2.0--3/"
    ref_data_hla_slice_bed = "s3://oncoanalyser-data/reference_data/other/grch38_alt.plus_homologous.bed"

}


process {

    errorStrategy = 'terminate'
    maxRetries = 0

    /*

    CloudOS job queues:

      - nextflow-task-ondemand-2cpu_16gb  nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a
      - nextflow-task-ondemand-4cpu_32gb  nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee
      - nextflow-task-ondemand-8cpu_32gb  nextflow-job-queue-6836ce692b367ba6069920b9-cca522f4-298f-431c-95a8
      - nextflow-task-ondemand-8cpu_64gb  nextflow-job-queue-6836ce692b367ba6069920b9-b34bbe20-f2a7-4820-88bc

      - nextflow-task-ondemand-8cpu_64gb-disk_optimised   nextflow-job-queue-6836ce692b367ba6069920b9-c4d29921-3851-449c-82eb
      - nextflow-task-ondemand-16cpu_128gb-disk_optimised nextflow-job-queue-6836ce692b367ba6069920b9-791ec53c-7475-4d05-a0f3
      - nextflow-task-ondemand-32cpu_64gb-disk_optimised  nextflow-job-queue-6836ce692b367ba6069920b9-590615be-a234-49c0-b8d1

    */

    withName: 'PICARD_FIXMATEINFORMATION' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
        time = 12.h
    }

    withName: 'FASTP' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-c4d29921-3851-449c-82eb'
        cpus = 8
        memory = 60.GB
        time = 12.h
    }

    withName: 'BWAMEM2_ALIGN' {

        // NOTE(SW): force temporary directory for `sambamba sort` to avoid filling system /tmp/
        ext.args3 = { "--tmpdir=${task.scratch}" }

        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-590615be-a234-49c0-b8d1'
        cpus = 32
        memory = 60.GB
    }

    withName: 'STAR_ALIGN' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-b34bbe20-f2a7-4820-88bc'
        cpus = 8
        memory = 60.GB
    }

    withName: 'SAMTOOLS_SORT' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'SAMBAMBA_MERGE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'GATK4_MARKDUPLICATES' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'REDUX' {
        errorStrategy = 'retry'
        maxRetries = 1

        ext.xmx_mod = { task.attempt == 1 ? null : 0.80 }

        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-791ec53c-7475-4d05-a0f3'
        cpus = { task.attempt == 1 ? 16 : 8 }
        memory = 120.GB
        time = 12.h
    }

    withName: 'AMBER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-b34bbe20-f2a7-4820-88bc'
        cpus = 8
        memory = 60.GB
    }

    withName: 'COBALT' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-b34bbe20-f2a7-4820-88bc'
        cpus = 8
        memory = 60.GB
    }

    withName: '.*:ESVEE_CALLING:ESVEE' {
        errorStrategy = 'retry'
        maxRetries = 1

        ext.xmx_mod = { task.attempt == 1 ? null : 0.80 }

        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-791ec53c-7475-4d05-a0f3'
        cpus = { task.attempt == 1 ? 16 : 8 }
        memory = 120.GB
        time = 12.h
    }

    withName: '.*:SAGE_CALLING:SAGE_GERMLINE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-cca522f4-298f-431c-95a8'
        cpus = 8
        memory = 30.GB
    }

    withName: '.*:SAGE_CALLING:SAGE_SOMATIC' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-590615be-a234-49c0-b8d1'
        cpus = 32
        memory = 60.GB
    }

    withName: '.*:SAGE_APPEND:SAGE_APPEND_GERMLINE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: '.*:SAGE_APPEND:SAGE_APPEND_SOMATIC' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    // NOTE(SW): PAVE somatic uses a significant amount of memory, runtime is usually less than 5-10 minutes

    withName: '.*:PAVE_ANNOTATION:PAVE_(?:GERMLINE|SOMATIC)' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: 'PURPLE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: '.*:LINX_ANNOTATION:LINX_GERMLINE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: '.*:LINX_ANNOTATION:LINX_SOMATIC' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: '.*:LINX_PLOTTING:LINX_VISUALISER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: '.*:LINX_PLOTTING:LINXREPORT' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'CIDER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: 'BAMTOOLS' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: 'CHORD' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: '.*:LILAC_CALLING:(?:EXTRACTCONTIG|REALIGNREADS|SLICEBAM)' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'LILAC' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'SIGS' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'TEAL.*' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: 'VIRUSBREAKEND' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-4b86208c-9ed6-4603-baee'
        cpus = 4
        memory = 30.GB
    }

    withName: 'VIRUSINTERPRETER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'ISOFOX' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-cca522f4-298f-431c-95a8'
        cpus = 8
        memory = 30.GB
    }

    withName: 'NEO_SCORER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: '.*:NEO_PREDICTION:NEO_ANNOTATE_FUSIONS' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'NEO_FINDER' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'CUPPA' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'PEACH' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

    withName: 'ORANGE' {
        queue = 'nextflow-job-queue-6836ce692b367ba6069920b9-60c080a9-fb14-43f3-964a'
        cpus = 1
        memory = 14.GB
    }

}
